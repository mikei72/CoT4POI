FROM python:3.10.18-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.lock pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install -r requirements.lock \
    && python -m pip install -e . --no-deps --no-build-isolation \
    && groupadd --gid 10001 nextpoi \
    && useradd --uid 10001 --gid nextpoi --create-home nextpoi \
    && mkdir -p /opt/next-poi/bundle /var/lib/next-poi/monitoring /mlruns \
    && chown -R nextpoi:nextpoi /var/lib/next-poi /mlruns

USER nextpoi

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=2).read()"

CMD ["python", "-m", "uvicorn", "next_poi.serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
